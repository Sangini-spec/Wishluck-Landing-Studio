{{ 'WL_CSS' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign composed = false
  if s.layout != blank and s.layout != 'family'
    assign composed = true
  endif
  assign surface_bg = s.background
  if composed
    case s.surface
      when 'muted'
        assign surface_bg = s.secondary
      when 'ink'
        assign surface_bg = s.text_color
      when 'brand'
        assign surface_bg = s.primary
    endcase
  endif
  assign bright = surface_bg | color_brightness
  assign count = s.image_count
  if product.images.size < count
    assign count = product.images.size
  endif
  if count < 1 and s.image != blank
    assign count = 1
  endif
-%}
{%- if composed -%}{%- assign vp = '--wl-c-' -%}{%- else -%}{%- assign vp = '--wl-' -%}{%- endif -%}
{% style %}
{{ s.heading_font | font_face: font_display: 'swap' }}
{{ s.body_font | font_face: font_display: 'swap' }}
#wl-{{ section.id }} {
  {{ vp }}bg: {{ s.background }}; {{ vp }}text: {{ s.text_color }}; {{ vp }}primary: {{ s.primary }}; {{ vp }}on-primary: {{ s.on_primary }};
  {{ vp }}secondary: {{ s.secondary }}; {{ vp }}stage: {{ s.stage }}; {{ vp }}button: {{ s.button_color }}; {{ vp }}button-text: {{ s.button_text }};
  --wl-heading: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
  --wl-body: {{ s.body_font.family }}, {{ s.body_font.fallback_families }};
  --wl-weight: {{ s.heading_weight }}; --wl-body-weight: {{ s.body_weight }};
  --wl-heading-size: {{ s.heading_size }}px; --wl-body-size: {{ s.body_size }}px;
  --wl-radius: {{ s.radius }}px; --wl-space: {{ s.spacing }}px; --wl-share: {{ s.media_share }};
}
{% endstyle %}
{% if s.show_section %}
<section id="wl-{{ section.id }}" class="wl wl-hero {% if composed %}wl-cx wl-img-{{ s.image_treatment }} wl-ty-{{ s.typography }} wl-hx-{{ s.layout }} wl-ms-{% if s.flip %}right{% else %}left{% endif %} wl-ir-{{ s.image_ratio }} wl-sf-{{ s.surface }} wl-ha-{{ s.alignment }} wl-cw-{{ s.content_width }}{% else %}wl-f-{{ s.family }} wl-img-{{ s.image_treatment }} wl-scale-{{ s.hero_scale }} wl-cs-{{ s.color_strategy }} wl-rh-{{ s.rhythm }} wl-ty-{{ s.typography }} wl-dl-{{ s.detail_layout }} wl-al-{{ s.alignment }} wl-ac-{{ s.accent_placement }}{% if s.flip %} wl-flip{% endif %}{% endif %}{% if bright < 110 %} wl-dark{% endif %}" data-wl-product data-currency="{{ cart.currency.iso_code }}">
<div class="wl-hero-grid">
  <div class="wl-mark" aria-hidden="true">{% for i in (1..4) %}<span>{{ s.brand_name | default: product.vendor | escape }}</span>{% endfor %}</div>
  <div class="wl-media" data-count="{{ count }}">
    {%- if count > 0 -%}
    {%- for i in (1..count) -%}
      {%- liquid
        assign idx = forloop.index0
        if forloop.first and s.image != blank
          assign img = s.image
        else
          assign img = product.images[idx]
        endif
        assign fname = img.src | split: '/' | last | split: '?' | first | upcase
        assign view = 'View'
        if fname contains '_LEFT'
          assign view = 'Left'
        elsif fname contains '_RIGHT'
          assign view = 'Right'
        elsif fname contains '_FRONT'
          assign view = 'Front'
        elsif fname contains '_BACK'
          assign view = 'Back'
        elsif fname contains '_TOP'
          assign view = 'Top'
        elsif fname contains '_BOTTOM'
          assign view = 'Bottom'
        elsif fname contains '_SIDE'
          assign view = 'Side'
        endif
        if forloop.first
          assign alt = s.image_alt | default: product.title
        else
          assign alt = product.title | append: ' Fig. 0' | append: forloop.index | append: ' · ' | append: view
        endif
      -%}
      {%- if img != blank -%}
      <figure class="wl-fig wl-fig-{{ forloop.index }}">
        {%- if forloop.first -%}
          {{ img | image_url: width: 1600 | image_tag: widths: '360,540,768,1080,1440,1600', sizes: '(max-width: 899px) 100vw, 60vw', loading: 'eager', fetchpriority: 'high', alt: alt }}
        {%- else -%}
          <button type="button" class="wl-thumb" data-wl-swap aria-label="Show view {{ forloop.index }}">{{ img | image_url: width: 1200 | image_tag: widths: '240,480,900,1200', sizes: '(max-width: 899px) 30vw, 30vw', loading: 'lazy', alt: alt }}</button>
        {%- endif -%}
        <figcaption class="wl-fig-cap">Fig. 0{{ forloop.index }} · {{ view }}</figcaption>
      </figure>
      {%- endif -%}
    {%- endfor -%}
    {%- endif -%}
  </div>
  <div class="wl-copy" id="wl-product-purchase">
    <p class="wl-kicker"><span>{{ s.brand_name | default: product.vendor | escape }}</span>{% if product.type != blank %}<span class="wl-kicker-meta">{{ product.type | escape }}</span>{% endif %}</p>
    <h1>{{ s.heading | default: product.title | escape }}</h1>
    <div class="wl-description">{{ s.description }}</div>
    <div class="wl-price"><span data-wl-price>{{ current_variant.price | money }}</span> <del data-wl-compare>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</del></div>
    <form method="post" action="{{ routes.cart_add_url }}" class="wl-form" id="wl-form-{{ section.id }}">
      <label for="wl-variant-{{ section.id }}">{{ s.variant_label | escape }}
        <select id="wl-variant-{{ section.id }}" name="id">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} - Sold out{% endunless %}</option>
          {%- endfor -%}
        </select>
      </label>
      <label for="wl-qty-{{ section.id }}">{{ s.quantity_label | escape }}<input id="wl-qty-{{ section.id }}" type="number" name="quantity" min="1" max="99" value="1" inputmode="numeric"></label>
      <button type="submit" data-label="{{ s.button_label | escape }}"{% unless current_variant.available %} disabled{% endunless %}>{{ s.button_label | escape }}</button>
      <div class="wl-status" role="status" aria-live="polite"></div>
    </form>
    {% if s.show_trust and s.trust_text != blank %}<div class="wl-trust">{{ s.trust_text }}</div>{% endif %}
    {% if s.button_link != blank %}<p class="wl-copy-link"><a href="{{ s.button_link }}">{{ s.link_label | escape }}</a></p>{% endif %}
  </div>
</div>
{% if s.show_sticky %}<div class="wl-sticky"><span class="wl-sticky-price" data-wl-price>{{ current_variant.price | money }}</span><button type="button">{{ s.button_label | escape }}</button></div>{% endif %}
</section>
<script src="{{ 'WL_JS' | asset_url }}" defer></script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"url":{{ canonical_url | json }}{% if product.featured_image %},"image":{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{% endif %},"description":{{ product.description | strip_html | json }},"brand":{"@type":"Brand","name":{{ product.vendor | json }}},"offers":{"@type":"Offer","url":{{ canonical_url | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"price":{{ current_variant.price | divided_by: 100.0 | json }},"availability":"https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}"}WL_RATING}
</script>
{% endif %}
{% schema %}
WL_SCHEMA
{% endschema %}
