# Copy placeholders only. Never commit .env or put real values in recordings.
DATABASE_URL=
PORT=8080
FRONTEND_URL=
SESSION_SECRET=

# Existing Wishluck custom app; tokens stay in server memory.
SHOPIFY_SHOP_DOMAIN=wishluck-ai-builder.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# Optional alternative: an explicitly connected managed integration.
# Leave blank when using the existing custom app above.
SHOPIFY_CONNECTOR_NAME=

# Replit provisions these; do not replace with your own key.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
LLM_PROVIDER=openai
TEXT_MODEL=gpt-5.4-mini
VISION_MODEL=gpt-5.4-mini
DESIGN_MODEL=gpt-5.4
DESIGN_LLM_INPUT_USD_PER_MILLION=2.5
DESIGN_LLM_OUTPUT_USD_PER_MILLION=15
# Cost estimates only, not a billing promise. Update for the configured model.
LLM_INPUT_USD_PER_MILLION=0.75
LLM_OUTPUT_USD_PER_MILLION=4.5
# Reserved for a future external-provider adapter; not used by this build.
LLM_API_KEY=

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional generic alias for the same Tavily key, not a different provider.
SEARCH_API_KEY=

# Replit App Storage provisions these.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
# Optional Chromium executable override.
CHROMIUM_PATH=

# Optional storefront viewing password, distinct from Theme Access/staff login.
# Use one secret per store. Never disable storefront password protection for audits.
SHOPIFY_STOREFRONT_PASSWORD_WISHLUCK_AI_BUILDER=

# Store-specific Theme Access token; never commit the actual value.
SHOPIFY_CLI_THEME_TOKEN_WISHLUCK_AI_BUILDER=
SHOPIFY_CLI_ALLOW_LIVE_PUBLISH=false
# Optional generic token is accepted only for this exact bound store.
SHOPIFY_FLAG_STORE=wishluck-ai-builder.myshopify.com
SHOPIFY_CLI_THEME_TOKEN=
# Development-only Vite reverse proxy; never exposed as a browser API URL.
API_PROXY_TARGET=http://127.0.0.1:8080
